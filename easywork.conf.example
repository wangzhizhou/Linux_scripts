# ── EasyWork 配置文件 ────────────────────────────────────
# 复制为 ~/.easywork/config 即可生效：
#   cp easywork.conf.example ~/.easywork/config
#
# 配置文件由 easywork config 命令管理，支持：
#   easywork config        查看配置内容
#   easywork config edit   编辑配置文件
#
# ── Git 身份配置 ─────────────────────────────────────────
# 运行 easywork git 时，可选择 personal 或 work 身份。
# 以下变量会被读取，设置后无需每次重新输入。
#
# 个人身份
GIT_PERSONAL_NAME=""
GIT_PERSONAL_EMAIL=""
#
# 工作身份
GIT_WORK_NAME=""
GIT_WORK_EMAIL=""

# ── 其他配置 ────────────────────────────────────────────
# （暂无其他配置项，后续版本可能扩展）
