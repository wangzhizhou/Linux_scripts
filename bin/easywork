#!/usr/bin/env bash
# -*- coding: utf-8 -*-
# EasyWork — Developer Environment Bootstrap Tool
# https://github.com/EasyIndie/EasyWork

set -euo pipefail

EASYWORK_VERSION="0.0.1"

# ─── Repository URLs (override via environment for forks/mirrors) ──
# Release download base — used by 'easywork update' to fetch specific versions
EASYWORK_RELEASE_URL="${EASYWORK_RELEASE_URL:-https://github.com/EasyIndie/EasyWork/releases/download}"
# Project homepage
EASYWORK_WEB_URL="${EASYWORK_WEB_URL:-https://github.com/EasyIndie/EasyWork}"
# GitHub API — used by 'easywork update' to check latest release
EASYWORK_API_URL="${EASYWORK_API_URL:-https://api.github.com/repos/EasyIndie/EasyWork/releases/latest}"

# ─── Determine Paths ──────────────────────────────────────────
# When piped via curl, $0 is "bash" or "-bash". Resolve to temp location.
if [[ "${BASH_SOURCE[0]:-}" =~ ^(bash|-bash|/dev/fd/|pipe:) ]] || [[ ! -f "$0" ]]; then
    EASYWORK_ROOT=""
    LIB_DIR=""
    IS_PIPED=true
else
    EASYWORK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
    LIB_DIR="${EASYWORK_ROOT}/lib"
    IS_PIPED=false
fi

# Raw content URL — version-matched for installed binary, main for piped
if $IS_PIPED; then
    EASYWORK_RAW_URL="${EASYWORK_RAW_URL:-https://raw.githubusercontent.com/EasyIndie/EasyWork/main}"
else
    EASYWORK_RAW_URL="${EASYWORK_RAW_URL:-https://raw.githubusercontent.com/EasyIndie/EasyWork/${EASYWORK_VERSION}}"
fi

# ─── Source Common Library ────────────────────────────────────
# Try local checkout first, then fall back to download (standalone/piped install)
_local_common="${LIB_DIR}/common.sh"
if [[ -f "$_local_common" ]]; then
    source "$_local_common"
else
    # Running piped or standalone — download lib files to persistent cache
    # (safe_download is defined in common.sh, so we bootstrap with curl directly)
    _CACHE_DIR="$HOME/.easywork/lib/v${EASYWORK_VERSION}"
    mkdir -p "$_CACHE_DIR"

    # Check cache first — avoids re-downloading on every invocation
    if [[ -f "$_CACHE_DIR/common.sh" ]]; then
        source "$_CACHE_DIR/common.sh"
        LIB_DIR="$_CACHE_DIR"
    else
        mkdir -p "$_CACHE_DIR"

        _download_common() {
            curl -fsSL --proto '=https' --tlsv1.2 --retry 3 \
                -o "$_CACHE_DIR/common.sh" \
                "${EASYWORK_RAW_URL}/lib/common.sh" 2> /dev/null
        }

        if ! _download_common; then
            # Fallback: version tag doesn't exist → use main branch
            echo "[WARN] 版本 tag 不存在，使用 main 分支" >&2
            EASYWORK_RAW_URL="https://raw.githubusercontent.com/EasyIndie/EasyWork/main"
            if ! _download_common; then
                echo "[ERROR] 无法下载 common.sh，请检查网络连接"
                echo "[INFO]  URL: ${EASYWORK_RAW_URL}/lib/common.sh"
                exit 2
            fi
        fi

        source "$_CACHE_DIR/common.sh"
        LIB_DIR="$_CACHE_DIR"
    fi
fi

# Channel: dev (development) or empty (release)
# Piped or local git checkout → dev; installed release binary → release
if $IS_PIPED || [[ -d "${EASYWORK_ROOT:-}/.git" ]]; then
    EASYWORK_CHANNEL="dev"
else
    EASYWORK_CHANNEL=""
fi

# ─── Module Auto-Discovery ────────────────────────────────────
_discover_modules() {
    local lib_dir="$1"

    if [[ ! -d "$lib_dir" ]]; then
        return 0
    fi

    # Download remote modules if running from cache dir (piped/standalone)
    if [[ -n "${_CACHE_DIR:-}" ]] && [[ "$lib_dir" == "$_CACHE_DIR" ]]; then
        # Download module index, then each listed module
        local modules_list
        modules_list="$(safe_download "${EASYWORK_RAW_URL}/MODULES" 2> /dev/null || true)"
        if [[ -n "$modules_list" ]]; then
            for mod in $modules_list; do
                [[ -n "$mod" ]] || continue
                # Reject module names with path traversal or unsafe characters
                if [[ "$mod" =~ [/] ]] || [[ "$mod" == ".." ]] || [[ "$mod" =~ [[:cntrl:]] ]] || [[ "$mod" =~ [^a-zA-Z0-9_-] ]]; then
                    log_warn "跳过非法模块名: $mod"
                    continue
                fi
                [[ -f "${_CACHE_DIR}/${mod}.sh" ]] || safe_download "${EASYWORK_RAW_URL}/lib/${mod}.sh" "${_CACHE_DIR}/${mod}.sh" 2> /dev/null || true
            done
        fi
    fi

    for f in "$lib_dir"/*.sh; do
        [[ -f "$f" ]] || continue
        # Skip common.sh itself
        [[ "$(basename "$f")" == "common.sh" ]] && continue

        # Reset module variables before sourcing
        unset MODULE_NAME MODULE_DESCRIPTION MODULE_PRIORITY
        source "$f"

        if [[ -z "${MODULE_NAME:-}" ]]; then
            log_warn "跳过 $f: 未定义 MODULE_NAME"
            continue
        fi

        register_module "$MODULE_NAME" "${MODULE_DESCRIPTION:-}" "${MODULE_PRIORITY:-50}"
    done
}

# ─── CLI: Version ─────────────────────────────────────────────
cmd_version() {
    echo "EasyWork ${EASYWORK_VERSION}${EASYWORK_CHANNEL:+ (${EASYWORK_CHANNEL})}"
    if manifest_exists; then
        echo "配置文件: $(config_path)"

        # Human-readable install date with timezone conversion
        local raw_date
        raw_date="$(manifest_read 'install_date' 'unknown')"
        if [[ "$raw_date" != "unknown" ]]; then
            echo "安装日期: $(format_date_human "$raw_date")"
        else
            echo "安装日期: unknown"
        fi

        local installed
        installed="$(manifest_list_installed | tr '\n' ' ')"
        if [[ -n "${installed// /}" ]]; then
            # Generic display: each module may declare a display_name in its manifest section
            local formatted_list=()
            local name display
            for name in $installed; do
                [[ -z "$name" ]] && continue
                display="$(manifest_read_section_key "$name" "display_name" "")"
                formatted_list+=("${display:-$name}")
            done
            echo "已安装组件: ${formatted_list[*]}"
        else
            echo "已安装组件: (无)"
        fi
    else
        echo "状态: 未安装（运行 easywork install 开始配置）"
    fi
}

# ─── CLI: Config ──────────────────────────────────────────────
cmd_config() {
    local sub="${1:-show}"
    case "$sub" in
        edit)
            config_edit
            ;;
        show | *)
            config_show
            ;;
    esac
}

# ─── CLI: Update ──────────────────────────────────────────────
cmd_update() {
    log_info "检查更新..."

    # Fetch latest release info from GitHub API
    local api_response
    api_response="$(safe_download "${EASYWORK_API_URL}" -H "Accept: application/vnd.github+json" 2> /dev/null || true)"

    local latest_version
    latest_version="$(echo "$api_response" | grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')"

    if [[ -z "$latest_version" ]]; then
        # Fallback: try reading VERSION from raw URL
        latest_version="$(safe_download "${EASYWORK_RAW_URL}/VERSION" 2> /dev/null | head -1 | tr -d '[:space:]')" || true
    fi

    # Normalize: ensure v prefix for GitHub release URL compatibility.
    # API returns "v1.0.0"; VERSION file has "1.0.0" (no v).
    if [[ -n "$latest_version" ]] && [[ "$latest_version" != v* ]]; then
        latest_version="v${latest_version}"
    fi

    if [[ -z "$latest_version" ]]; then
        log_error "无法检查更新，请检查网络连接"
        return $EXIT_NETWORK
    fi

    local current_version
    current_version="$(manifest_get_version)"
    current_version="${current_version:-0.0.0}"

    if ! _semver_is_newer "$latest_version" "$current_version"; then
        log_success "已是最新版本 ${current_version}"
        return $EXIT_SUCCESS
    fi

    log_info "当前版本: ${current_version}"
    log_info "最新版本: ${latest_version}"

    local answer="y"
    if [[ "${YES_MODE:-false}" != "true" ]]; then
        read -r -p "  升级到 ${latest_version}？[Y/n] " answer
    fi

    if [[ "$answer" =~ ^[Nn] ]]; then
        log_info "已取消升级"
        return $EXIT_SUCCESS
    fi

    # Self-update: download versioned release asset
    local easywork_path
    easywork_path="$(command -v easywork 2> /dev/null || echo '')"
    if [[ -n "$easywork_path" ]] && [[ -w "$easywork_path" ]]; then
        backup_file "$easywork_path"
        log_info "下载 ${latest_version}..."
        if safe_download "${EASYWORK_RELEASE_URL}/${latest_version}/bin/easywork" "$easywork_path"; then
            chmod +x "$easywork_path"
            log_success "已更新到 ${latest_version}"
        else
            log_error "下载失败，已保留当前版本"
            return $EXIT_NETWORK
        fi
    else
        log_warn "无法自更新（无写入权限），请手动执行一键安装命令"
        log_info "curl -sL ${EASYWORK_RAW_URL}/bin/easywork | bash -s -- install"
        return $EXIT_PERMISSION
    fi

    # Re-run install with new version
    log_info "应用最新配置..."
    exec "$easywork_path" install --yes
}

# ─── Shell Completion Setup ────────────────────────────────────
_detect_rc_file() {
    # Delegate to shell module if available, otherwise inline detection
    if declare -f _detect_shell_rc > /dev/null 2>&1; then
        _detect_shell_rc
        return
    fi
    local os_type sh_type
    os_type="$(detect_os)"
    sh_type="$(detect_shell)"
    # zsh always uses .zshrc regardless of OS
    if [[ "$sh_type" == "zsh" ]]; then
        echo "$HOME/.zshrc"
        return
    fi
    case "$os_type" in
        macos)
            case "$sh_type" in
                bash) echo "$HOME/.bash_profile" ;;
                *) echo "$HOME/.bashrc" ;;
            esac
            ;;
        *) echo "$HOME/.bashrc" ;;
    esac
}

_setup_completions() {
    if [[ "${DRY_RUN:-false}" == "true" ]]; then
        log_info "[DRY-RUN] 将配置 shell 补全"
        return 0
    fi

    local comp_dir="$HOME/.easywork/completions"
    mkdir -p "$comp_dir"

    # Build dynamic command list: built-in + registered modules
    local mod_list
    mod_list="$(list_modules_sorted 2> /dev/null | tr '\n' ' ' || true)"

    # Bash completion — context-aware: flags, subcommands, module names
    cat > "$comp_dir/easywork.bash" << BASH_COMP
_easywork() {
    COMPREPLY=()
    local cur
    cur="\${COMP_WORDS[COMP_CWORD]}"

    local global_opts="--yes -y --dry-run --verbose -v"
    local uninstall_opts="--keep-config --remove-config"
    local commands="install uninstall config version update help"
    local modules="${mod_list}"

    local cmd=""
    local i
    for ((i = 1; i < COMP_CWORD; i++)); do
        [[ "\${COMP_WORDS[i]}" != -* ]] && { cmd="\${COMP_WORDS[i]}"; break; }
    done

    if [[ "\$cur" == -* ]]; then
        local opts="\$global_opts"
        [[ "\$cmd" == "uninstall" ]] && opts="\$opts \$uninstall_opts"
        COMPREPLY=(\$(compgen -W "\$opts" -- "\$cur"))
        return
    fi

    if [[ -z "\$cmd" ]]; then
        COMPREPLY=(\$(compgen -W "\$commands \$modules" -- "\$cur"))
        return
    fi

    case "\$cmd" in
        install | uninstall) COMPREPLY=(\$(compgen -W "\$modules" -- "\$cur")) ;;
        config)              COMPREPLY=(\$(compgen -W "edit show" -- "\$cur")) ;;
    esac
}
complete -F _easywork easywork
BASH_COMP

    # Zsh completion — context-aware with flag descriptions and subcommand routing
    cat > "$comp_dir/_easywork" << ZSH_COMP
#compdef easywork

_arguments -C \\
    '--yes[跳过交互确认]' \\
    '-y[跳过交互确认]' \\
    '--dry-run[预览变更不执行]' \\
    '--verbose[详细输出]' \\
    '-v[详细输出]' \\
    '--keep-config[卸载时保留配置文件]' \\
    '--remove-config[卸载时删除配置文件]' \\
    "1:命令:(install uninstall config version update help ${mod_list})" \\
    '*::参数:->args'

case "\$state" in
    args)
        case "\${line[1]}" in
            install | uninstall) compadd ${mod_list} ;;
            config)              compadd edit show ;;
        esac
        ;;
esac
ZSH_COMP

    local rc_file
    rc_file="$(_detect_rc_file)"
    [[ -f "$rc_file" ]] || touch "$rc_file"

    local sh_type source_line
    sh_type="$(detect_shell)"
    if [[ "$sh_type" == "zsh" ]]; then
        source_line="fpath=($comp_dir \$fpath)"
    else
        source_line="source $comp_dir/easywork.bash  # EasyWork completion"
    fi

    if ! grep -qF "$source_line" "$rc_file" 2> /dev/null; then
        echo "" >> "$rc_file"
        echo "$source_line" >> "$rc_file"
        log_success "Shell 补全已配置 (${rc_file})"
    fi
}

_remove_completions() {
    if [[ "${DRY_RUN:-false}" == "true" ]]; then
        log_info "[DRY-RUN] 将移除 shell 补全配置"
        return 0
    fi

    local comp_dir="$HOME/.easywork/completions"
    local rc_file source_line sh_type
    rc_file="$(_detect_rc_file)"
    sh_type="$(detect_shell)"

    if [[ -f "$rc_file" ]]; then
        if [[ "$sh_type" == "zsh" ]]; then
            source_line="fpath=($comp_dir \$fpath)"
        else
            source_line="source $comp_dir/easywork.bash  # EasyWork completion"
        fi
        local tmpfile="${rc_file}.tmp.$$"
        grep -vF "$source_line" "$rc_file" > "$tmpfile" 2> /dev/null || true
        mv "$tmpfile" "$rc_file"
    fi

    rm -f "$comp_dir/easywork.bash" "$comp_dir/_easywork"
    rmdir "$comp_dir" 2> /dev/null || true
}

# ─── CLI: Install ─────────────────────────────────────────────
cmd_install() {
    local target="${1:-}"

    # Validate target module if specified
    if [[ -n "$target" ]]; then
        _discover_modules "$LIB_DIR"
        if ! module_registered "$target"; then
            log_error "未知组件: $target"
            echo ""
            log_info "可用组件:"
            list_modules
            return $EXIT_ERROR
        fi
    fi

    echo ""
    local channel_label="${EASYWORK_CHANNEL:+ (${EASYWORK_CHANNEL})}"
    printf "  %sEasyWork %s%s%s%s — 开发环境配置%s\n" "${C_CYAN}" "${C_RESET}" "${EASYWORK_VERSION}" "${channel_label}" "${C_CYAN}" "${C_RESET}"
    echo ""

    # Preflight check
    if ! preflight_check; then
        return $?
    fi

    acquire_lock || return $?

    # Detect old installation (from previous scripts/ era)
    if [[ -f "$HOME/.sh_config_custom" ]]; then
        if ! grep -qF "# >>> EasyWork managed section" "$HOME/.sh_config_custom" 2> /dev/null; then
            log_warn "检测到旧版 EasyWork 配置（无版本管理）"
            if [[ "${DRY_RUN:-false}" == "true" ]]; then
                log_info "[DRY-RUN] 将备份旧配置并迁移"
            elif [[ "${YES_MODE:-false}" != "true" ]]; then
                local answer
                read -r -p "  是否迁移到新版本？旧配置将备份后替换。[Y/n] " answer
                if [[ "$answer" =~ ^[Nn] ]]; then
                    log_info "跳过 Shell 配置迁移，其他组件正常安装"
                else
                    backup_file "$HOME/.sh_config_custom"
                    log_info "已备份旧配置"
                fi
            else
                backup_file "$HOME/.sh_config_custom"
            fi
        fi
    fi

    # Determine install mode
    local install_mode="fresh"
    if manifest_exists; then
        local installed_ver
        installed_ver="$(manifest_get_version)" || installed_ver="0.0.0"
        if [[ "$installed_ver" == "$EASYWORK_VERSION" ]]; then
            install_mode="same_version"
        elif _semver_is_newer "$EASYWORK_VERSION" "$installed_ver"; then
            install_mode="upgrade"
        else
            log_warn "已安装版本 (${installed_ver}) 高于当前 (${EASYWORK_VERSION})，可能是降级"
            install_mode="downgrade"
        fi
    fi

    case "$install_mode" in
        fresh)
            log_info "全新安装 EasyWork ${EASYWORK_VERSION}${EASYWORK_CHANNEL:+ (${EASYWORK_CHANNEL})}"
            config_init
            manifest_init "$EASYWORK_VERSION"
            ;;
        upgrade)
            log_info "升级: ${installed_ver} → ${EASYWORK_VERSION}${EASYWORK_CHANNEL:+ (${EASYWORK_CHANNEL})}"
            ;;
        same_version)
            log_info "已安装 ${EASYWORK_VERSION}${EASYWORK_CHANNEL:+ (${EASYWORK_CHANNEL})}，配置已是最新"
            if $IS_PIPED; then
                # Piped reinstall: skip config refresh, continue to binary overwrite
                :
            elif [[ -n "$target" ]]; then
                # Explicit target: continue to install specific module
                :
            elif [[ "${YES_MODE:-false}" != "true" ]]; then
                local answer
                read -r -p "  重新应用配置？[y/N] " answer
                if [[ ! "$answer" =~ ^[Yy] ]]; then
                    release_lock
                    return $EXIT_SUCCESS
                fi
            else
                release_lock
                return $EXIT_SUCCESS
            fi
            log_info "刷新配置..."
            ;;
    esac

    # Run all modules (skip in piped mode — CLI binary only)
    if ! $IS_PIPED; then
        local sorted
        sorted="$(list_modules_sorted)" || {
            log_error "无法获取模块列表"
            release_lock
            return $EXIT_ERROR
        }

        for name in $sorted; do
            # Filter by target if specified
            [[ -n "$target" && "$name" != "$target" ]] && continue
            echo ""
            log_info "配置 ${name}..."
            # Re-source module file so the correct module_install is in scope
            if [[ -f "${LIB_DIR}/${name}.sh" ]]; then
                source "${LIB_DIR}/${name}.sh"
            fi
            if module_install; then
                manifest_set_section "$name" \
                    "installed=true"
                log_success "${name} 完成"
            else
                log_error "[${name}] 失败"
            fi
        done
    fi

    # Update manifest version
    if manifest_exists; then
        local manifest_tmp
        manifest_tmp="$(mktemp)" || {
            log_error "无法创建临时文件 (mktemp 失败)"
            release_lock
            return $EXIT_ERROR
        }
        _register_temp_file "$manifest_tmp"
        sed "s/^easywork_version=.*/easywork_version=${EASYWORK_VERSION}/" "$MANIFEST_FILE" > "$manifest_tmp"
        mv "$manifest_tmp" "$MANIFEST_FILE"
    fi

    echo ""
    if $IS_PIPED; then
        local channel_label="${EASYWORK_CHANNEL:+ (${EASYWORK_CHANNEL})}"
        log_success "EasyWork ${EASYWORK_VERSION}${channel_label} CLI 准备就绪"
    else
        local channel_label="${EASYWORK_CHANNEL:+ (${EASYWORK_CHANNEL})}"
        log_success "EasyWork ${EASYWORK_VERSION}${channel_label} 安装完成 🎉"
        log_info "运行 easywork 查看可用命令"
    fi

    # Self-install: always overwrite binary when piped
    if $IS_PIPED; then
        echo ""
        log_info "安装 easywork 到系统路径..."
        local install_path
        if [[ -w "/usr/local/bin" ]]; then
            install_path="/usr/local/bin/easywork"
        elif [[ -d "$HOME/.local/bin" ]] || mkdir -p "$HOME/.local/bin" 2> /dev/null; then
            install_path="$HOME/.local/bin/easywork"
        fi
        if [[ -n "${install_path:-}" ]]; then
            if safe_download "${EASYWORK_RAW_URL}/bin/easywork" "$install_path" 2> /dev/null; then
                chmod +x "$install_path"
                if ! echo ":$PATH:" | grep -q ":$(dirname "$install_path"):"; then
                    log_warn "$(dirname "$install_path") 不在 \$PATH 中"
                    log_info "请添加以下行到你的 shell 配置: export PATH=\"$(dirname "$install_path"):\$PATH\""
                fi
                log_success "已安装 easywork 到 ${install_path}"
                log_info "运行 'easywork install' 完成组件配置"
            fi
        fi
    fi

    # Set up shell completions (skip in piped mode)
    if ! $IS_PIPED; then
        _setup_completions
    fi

    release_lock
}

# ─── CLI: Uninstall ───────────────────────────────────────────
cmd_uninstall() {
    local component="${1:-}"

    if ! manifest_exists; then
        log_error "未检测到安装记录（${MANIFEST_FILE} 不存在）"
        log_info "如果之前使用过 EasyWork，请手动清理模块配置文件:"
        log_info "  ~/.sh_config_custom, ~/.gitconfig, ~/.vimrc 等"
        return $EXIT_ERROR
    fi

    acquire_lock || return $?

    local targets=()
    if [[ -n "$component" ]]; then
        if ! manifest_section_exists "$component"; then
            log_error "组件 '$component' 未安装"
            release_lock
            return $EXIT_ERROR
        fi
        targets=("$component")
    else
        # All installed components
        local installed
        installed="$(manifest_list_installed)"
        if [[ -z "${installed// /}" ]]; then
            log_info "没有已安装的组件"
            # Still ask about config file
            release_lock
            _finalize_uninstall
            return $EXIT_SUCCESS
        fi
        for name in $installed; do
            targets+=("$name")
        done
    fi

    # Confirm
    if [[ "${YES_MODE:-false}" != "true" ]]; then
        echo "将卸载以下组件:"
        for t in "${targets[@]}"; do
            echo "  - $t"
        done
        local answer
        read -r -p "  确认卸载？[Y/n] " answer
        if [[ "$answer" =~ ^[Nn] ]]; then
            log_info "已取消卸载"
            release_lock
            return $EXIT_SUCCESS
        fi
    fi

    echo ""
    local failed_modules=()
    for t in "${targets[@]}"; do
        log_info "[${t}] 卸载中..."
        # Re-source module to ensure correct module_uninstall is in scope
        if [[ -f "${LIB_DIR}/${t}.sh" ]]; then
            source "${LIB_DIR}/${t}.sh"
            if ! declare -f module_uninstall > /dev/null 2>&1; then
                log_error "[${t}] 模块文件加载失败，跳过卸载"
                failed_modules+=("$t")
                continue
            fi
            if module_uninstall; then
                manifest_remove_section "$t"
                log_success "[${t}] 已卸载"
            else
                log_warn "[${t}] 卸载时出现警告，继续..."
                failed_modules+=("$t")
            fi
        else
            log_warn "[${t}] 模块文件未找到，跳过卸载"
            failed_modules+=("$t")
        fi
        echo ""
    done

    if [[ ${#failed_modules[@]} -gt 0 ]]; then
        log_warn "以下模块卸载失败（文件可能残留）: ${failed_modules[*]}"
    fi

    release_lock
    _finalize_uninstall
}

_finalize_uninstall() {
    # Remove shell completions
    _remove_completions

    local remaining
    remaining="$(manifest_list_installed | tr '\n' ' ')"
    if [[ -n "${remaining// /}" ]]; then
        log_info "以下组件仍安装: ${remaining}"
        log_info "配置文件和 manifest 已保留"
    else
        local answer="y"
        if [[ "${YES_MODE:-false}" != "true" ]]; then
            read -r -p "  保留 $(config_path) 以便将来使用？[Y/n] " answer
        elif [[ "${REMOVE_CONFIG:-false}" == "true" ]]; then
            answer="n"
        else
            answer="y"
        fi

        if [[ "$answer" =~ ^[Nn] ]]; then
            rm -f "$(config_path)"
            manifest_clear
            log_success "EasyWork 已完全移除 ✓"
        else
            log_info "配置文件已保留: $(config_path)"
            log_info "下次运行 easywork install 可直接复用身份信息"
        fi
    fi
}

# ─── CLI: Help ────────────────────────────────────────────────
cmd_help() {
    local module_count=0
    # shellcheck disable=SC2153  # MODULE_NAMES is defined in sourced common.sh
    if [[ ${#MODULE_NAMES[@]} -gt 0 ]]; then
        module_count="$(list_modules_sorted | awk 'END{print NR}')"
    fi

    cat << EOF
EasyWork — 开发环境一键配置 ${EASYWORK_VERSION}${EASYWORK_CHANNEL:+ (${EASYWORK_CHANNEL})}

用法:
  easywork <命令> [参数] [选项]

内置命令:
  install [组件]       一键安装全部组件（或指定单个组件）
  uninstall [组件]     卸载组件（不指定则卸载全部）
  config               查看配置文件内容及元信息
  config edit          编辑配置文件
  version              查看版本和已安装组件信息
  update               检查并升级到最新版本

EOF

    if [[ "$module_count" -gt 0 ]]; then
        echo "组件快捷命令 (${module_count} 个可用组件):"
    else
        echo "组件快捷命令:"
    fi
    echo ""
    list_modules
    echo ""

    if [[ "$module_count" -gt 0 ]]; then
        echo "  提示: 输入 easywork <组件名> 可单独安装该组件"
        echo ""
    fi

    cat << EOF
全局选项:
  --dry-run             预览变更，不实际执行
  --yes, -y             跳过交互确认
  --verbose, -v         详细输出
  --keep-config         卸载时保留配置文件
  --remove-config       卸载时移除配置文件

EOF
}

# ─── Main: Parse & Route ──────────────────────────────────────
YES_MODE=false
DRY_RUN=false
VERBOSE=false
REMOVE_CONFIG=false

_parse_global_flags() {
    _PARSED_ARGS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --yes | -y)
                YES_MODE=true
                shift
                ;;
            --dry-run)
                DRY_RUN=true
                shift
                ;;
            --verbose | -v)
                VERBOSE=true
                shift
                ;;
            --keep-config)
                REMOVE_CONFIG=false
                shift
                ;;
            --remove-config)
                REMOVE_CONFIG=true
                shift
                ;;
            *)
                _PARSED_ARGS+=("$1")
                shift
                ;;
        esac
    done
}

main() {
    # Parse global flags (must NOT run in subshell — flags modify current shell)
    _parse_global_flags "$@"
    set -- "${_PARSED_ARGS[@]:-}"

    local cmd="${1:-}"

    # Pipe detection: if stdin is not a tty, default to install + non-interactive
    if [[ -z "$cmd" ]]; then
        if [[ ! -t 0 ]] || $IS_PIPED; then
            cmd="install"
            YES_MODE=true
        else
            cmd="help"
        fi
    elif $IS_PIPED && [[ "$cmd" == "install" ]]; then
        # Piped with explicit command — also force non-interactive
        YES_MODE=true
    fi

    # Discover modules (only when needed; skip for piped install)
    if ! $IS_PIPED || [[ "$cmd" != "install" ]]; then
        local _need_modules=false
        case "$cmd" in
            install | uninstall | help) _need_modules=true ;;
            config | version | update) _need_modules=false ;;
            *) _need_modules=true ;; # Unknown: might be a module name
        esac
        if $_need_modules && [[ -n "$LIB_DIR" ]]; then
            _discover_modules "$LIB_DIR"
        fi
    fi

    case "$cmd" in
        install)
            shift || true
            cmd_install "$@"
            ;;
        uninstall)
            shift || true
            cmd_uninstall "$@"
            ;;
        config)
            shift || true
            cmd_config "$@"
            ;;
        version)
            cmd_version
            ;;
        update)
            cmd_update
            ;;
        --help | -h)
            cmd_help
            ;;
        *)
            # Graceful fallback for removed 'help' subcommand
            if [[ "$cmd" == "help" ]]; then
                cmd_help
                exit 0
            fi
            # Try module route
            if module_registered "$cmd"; then
                # Re-source the correct module to get its functions
                if [[ -f "${LIB_DIR}/${cmd}.sh" ]]; then
                    source "${LIB_DIR}/${cmd}.sh"
                    if declare -f module_install > /dev/null 2>&1; then
                        acquire_lock || exit $?
                        if module_install; then
                            manifest_set_section "$cmd" "installed=true"
                            log_success "${cmd} 完成"
                        else
                            log_error "[${cmd}] 失败"
                        fi
                        release_lock
                    else
                        log_error "模块 '$cmd' 未实现 module_install"
                    fi
                else
                    log_error "模块文件未找到: ${LIB_DIR}/${cmd}.sh"
                fi
            else
                log_error "未知命令: $cmd"
                echo ""
                cmd_help
                exit $EXIT_ERROR
            fi
            ;;
    esac
}

main "$@"
