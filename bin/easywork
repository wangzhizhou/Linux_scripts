#!/usr/bin/env bash
# -*- coding: utf-8 -*-
# EasyWork — Developer Environment Bootstrap Tool
# https://github.com/EasyIndie/EasyWork

set -euo pipefail

EASYWORK_VERSION="0.0.1"

# ─── Repository URLs (override via environment for forks/mirrors) ──
# Release download base — used by 'easywork update' to fetch specific versions
EASYWORK_RELEASE_URL="${EASYWORK_RELEASE_URL:-https://github.com/EasyIndie/EasyWork/releases/download}"
# Project homepage
EASYWORK_WEB_URL="${EASYWORK_WEB_URL:-https://github.com/EasyIndie/EasyWork}"
# GitHub API — used by 'easywork update' to check latest release
EASYWORK_API_URL="${EASYWORK_API_URL:-https://api.github.com/repos/EasyIndie/EasyWork/releases/latest}"

# ─── Determine Paths ──────────────────────────────────────────
# When piped via curl, $0 is "bash" or "-bash". Resolve to temp location.
if [[ "${BASH_SOURCE[0]:-}" =~ ^(bash|-bash|/dev/fd/|pipe:) ]] || [[ ! -f "$0" ]]; then
    EASYWORK_ROOT=""
    LIB_DIR=""
    IS_PIPED=true
else
    EASYWORK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
    LIB_DIR="${EASYWORK_ROOT}/lib"
    IS_PIPED=false
fi

# Raw content URL — version-matched; fallback to main when tag is missing
if $IS_PIPED; then
    EASYWORK_RAW_URL="${EASYWORK_RAW_URL:-https://raw.githubusercontent.com/EasyIndie/EasyWork/${EASYWORK_VERSION}}"
else
    EASYWORK_RAW_URL="${EASYWORK_RAW_URL:-https://raw.githubusercontent.com/EasyIndie/EasyWork/${EASYWORK_VERSION}}"
fi

# ─── Source Common Library ────────────────────────────────────
# Try local checkout first, then fall back to download (standalone/piped install)
_local_common="${LIB_DIR}/common.sh"
if [[ -f "$_local_common" ]]; then
    source "$_local_common"
else
    # Running piped or standalone — download lib files to persistent cache
    # (safe_download is defined in common.sh, so we bootstrap with curl directly)
    _CACHE_DIR="$HOME/.easywork/lib/v${EASYWORK_VERSION}"
    mkdir -p "$_CACHE_DIR"

    # Check cache first — avoids re-downloading on every invocation
    if [[ -f "$_CACHE_DIR/common.sh" ]]; then
        source "$_CACHE_DIR/common.sh"
        LIB_DIR="$_CACHE_DIR"
    else
        mkdir -p "$_CACHE_DIR"

        _download_common() {
            curl -fsSL --proto '=https' --tlsv1.2 --retry 3 \
                -o "$_CACHE_DIR/common.sh" \
                "${EASYWORK_RAW_URL}/lib/common.sh" 2> /dev/null
        }

        if ! _download_common; then
            # Fallback: version tag doesn't exist → use main branch
            echo "[WARN] 版本 tag 不存在，使用 main 分支" >&2
            EASYWORK_RAW_URL="https://raw.githubusercontent.com/EasyIndie/EasyWork/main"
            if ! _download_common; then
                echo "[ERROR] 无法下载 common.sh，请检查网络连接"
                echo "[INFO]  URL: ${EASYWORK_RAW_URL}/lib/common.sh"
                exit 2
            fi
        fi

        source "$_CACHE_DIR/common.sh"
        LIB_DIR="$_CACHE_DIR"
    fi
fi

# Channel: dev (local git checkout or main-branch piped) or empty (release)
if [[ -d "${EASYWORK_ROOT:-}/.git" ]]; then
    EASYWORK_CHANNEL="dev"
elif $IS_PIPED && [[ "$EASYWORK_RAW_URL" == */main* ]]; then
    EASYWORK_CHANNEL="dev"
else
    EASYWORK_CHANNEL=""
fi

# ─── Ensure RAW_URL has the library files we need (version tag may be stale) ───
# Probe for a file that only exists post-refactoring: completions.sh
if $IS_PIPED || [[ -n "${_CACHE_DIR:-}" ]]; then
    _probe_url="${EASYWORK_RAW_URL}/lib/completions.sh"
    if ! curl -fsSL --proto '=https' --tlsv1.2 --connect-timeout 5 -o /dev/null "$_probe_url" 2> /dev/null; then
        EASYWORK_RAW_URL="https://raw.githubusercontent.com/EasyIndie/EasyWork/main"
    fi
fi

# ─── Source Additional Library Files ────────────────────────────
# After common.sh is loaded, source completions.sh and install.sh from
# the same LIB_DIR (local or piped cache).
for _ew_lib in completions.sh install.sh; do
    _ew_lib_path="${LIB_DIR}/${_ew_lib}"
    if [[ -f "$_ew_lib_path" ]]; then
        source "$_ew_lib_path"
    elif [[ -n "${_CACHE_DIR:-}" ]]; then
        _ew_cache_path="${_CACHE_DIR}/${_ew_lib}"
        if [[ ! -f "$_ew_cache_path" ]]; then
            # Download lib file from GitHub — don't silently ignore failures
            if ! safe_download "${EASYWORK_RAW_URL}/lib/${_ew_lib}" "$_ew_cache_path"; then
                echo "[ERROR] 无法下载 ${_ew_lib}，请检查网络连接" >&2
                echo "[INFO]  URL: ${EASYWORK_RAW_URL}/lib/${_ew_lib}" >&2
                exit 2
            fi
        fi
        if [[ -f "$_ew_cache_path" ]]; then
            source "$_ew_cache_path" || {
                echo "[ERROR] ${_ew_lib} 加载失败" >&2
                exit 1
            }
        fi
    fi
done
unset _ew_lib _ew_lib_path _ew_cache_path

# Post-load verification: critical functions must be available
if ! declare -f cmd_install > /dev/null 2>&1; then
    echo "[ERROR] 关键函数 cmd_install 未定义，install.sh 可能加载失败" >&2
    exit 1
fi

# ─── Module Auto-Discovery ────────────────────────────────────
_discover_modules() {
    local lib_dir="$1"

    if [[ ! -d "$lib_dir" ]]; then
        return 0
    fi

    # Download remote modules if running from cache dir (piped/standalone)
    if [[ -n "${_CACHE_DIR:-}" ]] && [[ "$lib_dir" == "$_CACHE_DIR" ]]; then
        # Download module index, then each listed module
        local modules_list
        modules_list="$(safe_download "${EASYWORK_RAW_URL}/MODULES" 2> /dev/null || true)"
        if [[ -n "$modules_list" ]]; then
            for mod in $modules_list; do
                [[ -n "$mod" ]] || continue
                # Reject module names with path traversal or unsafe characters
                if [[ "$mod" =~ [/] ]] || [[ "$mod" == ".." ]] || [[ "$mod" =~ [[:cntrl:]] ]] || [[ "$mod" =~ [^a-zA-Z0-9_-] ]]; then
                    log_warn "跳过非法模块名: $mod"
                    continue
                fi
                [[ -f "${_CACHE_DIR}/${mod}.sh" ]] || safe_download "${EASYWORK_RAW_URL}/lib/${mod}.sh" "${_CACHE_DIR}/${mod}.sh" 2> /dev/null || true
            done
        fi
    fi

    for f in "$lib_dir"/*.sh; do
        [[ -f "$f" ]] || continue
        # Skip library files that are not modules
        local _skip_lib
        _skip_lib="$(basename "$f")"
        [[ "$_skip_lib" == "common.sh" ]] && continue
        [[ "$_skip_lib" == "completions.sh" ]] && continue
        [[ "$_skip_lib" == "install.sh" ]] && continue

        # Reset module variables before sourcing
        unset MODULE_NAME MODULE_DESCRIPTION MODULE_PRIORITY
        source "$f"

        if [[ -z "${MODULE_NAME:-}" ]]; then
            log_warn "跳过 $f: 未定义 MODULE_NAME"
            continue
        fi

        # Validate module contract: must define install and uninstall functions
        if ! declare -f module_install > /dev/null 2>&1; then
            log_warn "跳过 ${MODULE_NAME}: 未定义 module_install 函数"
            continue
        fi
        if ! declare -f module_uninstall > /dev/null 2>&1; then
            log_warn "跳过 ${MODULE_NAME}: 未定义 module_uninstall 函数"
            continue
        fi

        register_module "$MODULE_NAME" "${MODULE_DESCRIPTION:-}" "${MODULE_PRIORITY:-50}"
    done
}

# ─── CLI: Version ─────────────────────────────────────────────
cmd_version() {
    echo "EasyWork ${EASYWORK_VERSION}${EASYWORK_CHANNEL:+ (${EASYWORK_CHANNEL})}"
    if manifest_exists; then
        echo "配置文件: $(config_path)"

        # Human-readable install date with timezone conversion
        local raw_date
        raw_date="$(manifest_read 'install_date' 'unknown')"
        if [[ "$raw_date" != "unknown" ]]; then
            echo "安装日期: $(format_date_human "$raw_date")"
        else
            echo "安装日期: unknown"
        fi

        local installed
        installed="$(manifest_list_installed | tr '\n' ' ')"
        if [[ -n "${installed// /}" ]]; then
            # Generic display: each module may declare a display_name in its manifest section
            local formatted_list=()
            local name display
            for name in $installed; do
                [[ -z "$name" ]] && continue
                display="$(manifest_read_section_key "$name" "display_name" "")"
                formatted_list+=("${display:-$name}")
            done
            echo "已安装组件: ${formatted_list[*]}"
        else
            echo "已安装组件: (无)"
        fi
    else
        echo "状态: 未安装（运行 easywork install 开始配置）"
    fi
}

# ─── CLI: Config ──────────────────────────────────────────────
cmd_config() {
    local sub="${1:-show}"
    case "$sub" in
        edit)
            config_edit
            ;;
        show | *)
            config_show
            ;;
    esac
}

# ─── CLI: Update ──────────────────────────────────────────────
cmd_update() {
    log_info "检查更新..."

    # Fetch latest release info from GitHub API
    local api_response
    api_response="$(safe_download "${EASYWORK_API_URL}" -H "Accept: application/vnd.github+json" 2> /dev/null || true)"

    local latest_version
    latest_version="$(echo "$api_response" | grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')"

    if [[ -z "$latest_version" ]]; then
        # Fallback: try reading VERSION from raw URL
        latest_version="$(safe_download "${EASYWORK_RAW_URL}/VERSION" 2> /dev/null | head -1 | tr -d '[:space:]')" || true
    fi

    # Normalize: ensure v prefix for GitHub release URL compatibility.
    # API returns "v1.0.0"; VERSION file has "1.0.0" (no v).
    if [[ -n "$latest_version" ]] && [[ "$latest_version" != v* ]]; then
        latest_version="v${latest_version}"
    fi

    if [[ -z "$latest_version" ]]; then
        log_error "无法检查更新，请检查网络连接"
        return $EXIT_NETWORK
    fi

    local current_version
    current_version="$(manifest_get_version)"
    current_version="${current_version:-0.0.0}"

    if ! _semver_is_newer "$latest_version" "$current_version"; then
        log_success "已是最新版本 ${current_version}"
        return $EXIT_SUCCESS
    fi

    log_info "当前版本: ${current_version}"
    log_info "最新版本: ${latest_version}"

    local answer="y"
    if [[ "${YES_MODE:-false}" != "true" ]]; then
        read -r -p "  升级到 ${latest_version}？[Y/n] " answer
    fi

    if [[ "$answer" =~ ^[Nn] ]]; then
        log_info "已取消升级"
        return $EXIT_SUCCESS
    fi

    # Self-update: download versioned release asset
    local easywork_path
    easywork_path="$(command -v easywork 2> /dev/null || echo '')"
    if [[ -z "$easywork_path" ]] || [[ ! -w "$easywork_path" ]]; then
        log_warn "无法自更新（无写入权限），请手动执行一键安装命令"
        log_info "curl -sL ${EASYWORK_RAW_URL}/bin/easywork | bash -s -- install"
        return $EXIT_PERMISSION
    fi

    # Download to temp path first, verify, then replace
    local tmp_bin
    tmp_bin="$(mktemp)" || {
        log_error "无法创建临时文件"
        return $EXIT_ERROR
    }
    _register_temp_file "$tmp_bin"

    log_info "下载 ${latest_version}..."
    if ! safe_download "${EASYWORK_RELEASE_URL}/${latest_version}/bin/easywork" "$tmp_bin"; then
        log_error "下载失败，已保留当前版本"
        return $EXIT_NETWORK
    fi

    # Verify: try to download checksum file — if available, verify integrity
    local sha256_url="${EASYWORK_RELEASE_URL}/${latest_version}/bin/easywork.sha256"
    local sha256_file
    sha256_file="$(mktemp)" || {
        log_error "无法创建临时文件"
        rm -f "$tmp_bin"
        return $EXIT_ERROR
    }
    _register_temp_file "$sha256_file"

    if curl -fsSL --proto '=https' --tlsv1.2 --retry 2 -o "$sha256_file" "$sha256_url" 2> /dev/null; then
        local expected_hash
        expected_hash="$(head -1 "$sha256_file" | awk '{print $1}')"
        if [[ -n "$expected_hash" ]]; then
            log_verbose "验证 SHA256 校验和..."
            if ! _sha256_check "$tmp_bin" "$expected_hash"; then
                log_error "文件完整性校验失败，放弃更新"
                log_error "请检查网络或手动下载安装"
                rm -f "$tmp_bin" "$sha256_file"
                return $EXIT_NETWORK
            fi
            log_success "SHA256 校验通过"
        fi
    else
        log_verbose "无校验和文件，跳过完整性校验"
    fi
    rm -f "$sha256_file"

    # Verify the binary is executable and responds
    chmod +x "$tmp_bin"
    if ! "$tmp_bin" --version > /dev/null 2>&1; then
        log_error "下载的文件无法执行，放弃更新"
        rm -f "$tmp_bin"
        return $EXIT_ERROR
    fi

    # Backup current binary and replace
    backup_file "$easywork_path" > /dev/null 2>&1 || true
    if mv "$tmp_bin" "$easywork_path"; then
        chmod +x "$easywork_path"
        log_success "已更新到 ${latest_version}"
    else
        log_error "无法写入 ${easywork_path}，请检查权限"
        rm -f "$tmp_bin"
        return $EXIT_PERMISSION
    fi

    # Re-run install with new version
    log_info "应用最新配置..."
    exec "$easywork_path" install --yes
}

# ─── CLI: Help ────────────────────────────────────────────────
cmd_help() {
    local module_count=0
    # shellcheck disable=SC2153  # MODULE_NAMES is defined in sourced common.sh
    if [[ ${#MODULE_NAMES[@]} -gt 0 ]]; then
        module_count="$(list_modules_sorted | awk 'END{print NR}')"
    fi

    cat << EOF
EasyWork — 开发环境一键配置 ${EASYWORK_VERSION}${EASYWORK_CHANNEL:+ (${EASYWORK_CHANNEL})}

用法:
  easywork <命令> [参数] [选项]

内置命令:
  install [组件]       一键安装全部组件（或指定单个组件）
  uninstall [组件]     卸载组件（不指定则卸载全部）
  config               查看配置文件内容及元信息
  config edit          编辑配置文件
  version              查看版本和已安装组件信息
  update               检查并升级到最新版本
  completion           安装、移除或查看 shell 补全状态

EOF

    if [[ "$module_count" -gt 0 ]]; then
        echo "组件快捷命令 (${module_count} 个可用组件):"
    else
        echo "组件快捷命令:"
    fi
    echo ""
    list_modules
    echo ""

    if [[ "$module_count" -gt 0 ]]; then
        echo "  提示: 输入 easywork <组件名> 可单独安装该组件"
        echo ""
    fi

    cat << EOF
全局选项:
  --dry-run             预览变更，不实际执行
  --yes, -y             跳过交互确认
  --verbose, -v         详细输出
  --keep-config         卸载时保留配置文件
  --remove-config       卸载时移除配置文件

EOF
}

# ─── Main: Parse & Route ──────────────────────────────────────
YES_MODE=false
DRY_RUN=false
VERBOSE=false
REMOVE_CONFIG=false

_parse_global_flags() {
    _PARSED_ARGS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --yes | -y)
                YES_MODE=true
                shift
                ;;
            --dry-run)
                DRY_RUN=true
                shift
                ;;
            --verbose | -v)
                VERBOSE=true
                shift
                ;;
            --keep-config)
                REMOVE_CONFIG=false
                shift
                ;;
            --remove-config)
                REMOVE_CONFIG=true
                shift
                ;;
            *)
                _PARSED_ARGS+=("$1")
                shift
                ;;
        esac
    done
}

main() {
    # Parse global flags (must NOT run in subshell — flags modify current shell)
    _parse_global_flags "$@"
    set -- "${_PARSED_ARGS[@]:-}"

    local cmd="${1:-}"

    # Pipe detection: if stdin is not a tty, default to install + non-interactive
    if [[ -z "$cmd" ]]; then
        if [[ ! -t 0 ]] || $IS_PIPED; then
            cmd="install"
            YES_MODE=true
        else
            cmd="help"
        fi
    elif $IS_PIPED && [[ "$cmd" == "install" ]]; then
        # Piped with explicit command — also force non-interactive
        YES_MODE=true
    fi

    # Discover modules (only when needed; skip for piped install)
    if ! $IS_PIPED || [[ "$cmd" != "install" ]]; then
        local _need_modules=false
        case "$cmd" in
            install | uninstall | help) _need_modules=true ;;
            config | version | update) _need_modules=false ;;
            *) _need_modules=true ;; # Unknown: might be a module name
        esac
        if $_need_modules && [[ -n "$LIB_DIR" ]]; then
            _discover_modules "$LIB_DIR"
        fi
    fi

    case "$cmd" in
        install)
            shift || true
            cmd_install "$@"
            ;;
        uninstall)
            shift || true
            cmd_uninstall "$@"
            ;;
        config)
            shift || true
            cmd_config "$@"
            ;;
        completion | comp)
            shift || true
            cmd_completion "$@"
            ;;
        version)
            cmd_version
            ;;
        update)
            cmd_update
            ;;
        --help | -h)
            cmd_help
            ;;
        *)
            # Graceful fallback for removed 'help' subcommand
            if [[ "$cmd" == "help" ]]; then
                cmd_help
                exit 0
            fi
            # Try module route
            if module_registered "$cmd"; then
                # Re-source the correct module to get its functions
                if [[ -f "${LIB_DIR}/${cmd}.sh" ]]; then
                    source "${LIB_DIR}/${cmd}.sh"
                    if declare -f module_install > /dev/null 2>&1; then
                        acquire_lock || exit $?
                        if module_install; then
                            manifest_set_section "$cmd" "installed=true"
                            log_success "${cmd} 完成"
                        else
                            log_error "[${cmd}] 失败"
                            manifest_set_section "$cmd" \
                                "installed=failed" \
                                "failed_at=$(date +%Y-%m-%dT%H:%M:%S%z)"
                            log_warn "请修复问题后重试: easywork $cmd"
                        fi
                        release_lock
                    else
                        log_error "模块 '$cmd' 未实现 module_install"
                    fi
                else
                    log_error "模块文件未找到: ${LIB_DIR}/${cmd}.sh"
                fi
            else
                log_error "未知命令: $cmd"
                echo ""
                cmd_help
                exit $EXIT_ERROR
            fi
            ;;
    esac
}

main "$@"
