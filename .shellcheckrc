# ShellCheck configuration for EasyWork
# https://www.shellcheck.net/wiki/

# Enable all optional checks
enable=all

# Disable specific rules that don't apply
# SC1090: Can't follow non-constant source (we source user config files at runtime)
# SC1091: Not following (external scripts we download at runtime)
# SC2034: Unused variables (module files export variables used by easywork CLI)
# SC2154: Referenced but not assigned (module variables set by easywork runtime)
# SC2086: Double quote to prevent word splitting (many false positives in our usage)
# SC2250: Prefer braces around variable references (purely stylistic)
# SC2310: Function invoked in condition disabling set -e (info only)
# SC2312: Command invoked in subshell masking return value (info only)
# SC2119/SC2120: Function argument warnings (false positives in our usage)
# SC2248: Prefer explicit exit code (minor style)
# SC2249: Consider adding default case (minor style)
disable=SC1090,SC1091,SC2034,SC2154,SC2086,SC2119,SC2120,SC2248,SC2249,SC2250,SC2310,SC2312,SC2317

# Source paths (relative to repo root)
external-sources=true
